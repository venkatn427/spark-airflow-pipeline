# Copy this file to .env and fill in values before running docker compose.

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW_GID=0

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

# ── Spark workers ─────────────────────────────────────────────────────────────
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2
